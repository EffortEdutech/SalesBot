APP_ENV=development
HOST=0.0.0.0
PORT=4170
LOG_LEVEL=info

# SalesBot operational PostgreSQL / Supabase.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN_PEPPER=replace-with-64-random-hex-characters
BRIDGE_REQUIRE_TENANT_HEADER=true

# Browser always talks to Bridge through Vite's /bridge proxy in development.
VITE_BRIDGE_BASE_URL=/bridge
VITE_DEFAULT_TENANT_ID=tenant_hvac_pilot
BRIDGE_PROXY_TARGET=http://127.0.0.1:4170
SALESBOT_DEV_OPEN=true

# Self-hosted Bidwright target.
BIDWRIGHT_BASE_URL=http://127.0.0.1:4171
BIDWRIGHT_SERVICE_EMAIL=
BIDWRIGHT_SERVICE_PASSWORD=
BIDWRIGHT_ORG_SLUG=
BIDWRIGHT_EXPECTED_ORG_ID=
BIDWRIGHT_TIMEOUT_MS=10000

BIDWRIGHT_CONTRACT=0
BIDWRIGHT_CONTRACT_MUTATION=0

BRIDGE_PILOT_TENANT_ID=tenant_hvac_pilot
HVAC_PILOT_PRICE_BOOK_NAME=HVAC Pilot
HVAC_PILOT_EFFECTIVE_DATE=2026-08-19
HVAC_PILOT_EXPIRY_DATE=2027-08-18
