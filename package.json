{
  "name": "frontdesk-q",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "\u003e=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test \u0026\u0026 vitest run tests/m1",
    "test:contract": "vitest run tests/contract",
    "ci": "pnpm lint \u0026\u0026 pnpm format:check \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test",
    "provision:hvac-pilot": "tsx scripts/provision-hvac-pilot.ts",
    "test:m1": "vitest run tests/m1",
    "dev:bridge": "pnpm --filter @frontdesk-q/bridge-api dev",
    "dev:web": "pnpm --filter @frontdesk-q/salesbot-web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  },
  "type": "module",
  "dependencies": {
    "@frontdesk-q/bidwright": "workspace:*",
    "@frontdesk-q/db": "workspace:*",
    "@frontdesk-q/pricing": "workspace:*"
  }
}
